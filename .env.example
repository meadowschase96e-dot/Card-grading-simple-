# Supabase → Project Settings → Database → Connection string.
# Use the direct host (db.<ref>.supabase.co:5432) or the session pooler.
# Do not use the transaction pooler (port 6543). Migrations run several statements at once.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.zymeviqbqxugktmizvtv.supabase.co:5432/postgres

# Public project. Safe in the browser. Overrides the built-in project if set.
VITE_SUPABASE_URL=https://zymeviqbqxugktmizvtv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_klc2xzWccABhpST5U4lsXA_ToOuafej

# Random 32+ character secret. Required once DATABASE_URL is set.
BETTER_AUTH_SECRET=

# Public origin of the deployed app, no trailing slash.
BETTER_AUTH_URL=https://your-app.example.com

# xAI key. Server only. Used for live card prices.
XAI_API_KEY=

# Firebase web app. Project settings → Your apps → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave true so sign-in stays on when the database is configured.
VITE_AUTH_ENABLED=true

